# ==============================================================================
# Seekr Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
POSTGRES_USER=seekr
POSTGRES_PASSWORD=seekr_secret
POSTGRES_DB=seekr_db
POSTGRES_PORT=5435
DATABASE_URL=postgresql://seekr:seekr_secret@localhost:5435/seekr_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate secure random 64-character strings for production)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_chars_seekr_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_seekr_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Configuration
# Provider: gemini | openai | local
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# API Keys (Provide your own key for external AI providers)
GEMINI_API_KEY=
OPENAI_API_KEY=
