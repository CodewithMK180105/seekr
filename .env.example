# ==============================================================================
# Seekr Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (PostgreSQL with pgvector)
POSTGRES_USER=seekr
POSTGRES_PASSWORD=seekr_secret
POSTGRES_DB=seekr_db
POSTGRES_PORT=5435
DATABASE_URL=postgresql://seekr:seekr_secret@localhost:5435/seekr_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate secure random 64-character strings for production)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_chars_seekr_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_seekr_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Configuration
# Provider: gemini | openai | local
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

# API Keys (Provide your own key for external AI providers)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Rate Limiting (Requests per minute)
RATE_LIMIT_DISABLED=false
RATE_LIMIT_SEARCH_ANON=60
RATE_LIMIT_SEARCH_AUTH=180
RATE_LIMIT_RESEARCH_ANON=10
RATE_LIMIT_RESEARCH_AUTH=30
RATE_LIMIT_SUGGESTIONS_ANON=120
RATE_LIMIT_SUGGESTIONS_AUTH=300
RATE_LIMIT_GLOBAL_ANON=120
RATE_LIMIT_GLOBAL_AUTH=300

# Multi-Tier Caching & Invalidation
SEMANTIC_CACHE_SEARCH_THRESHOLD=0.88
SEMANTIC_CACHE_RESEARCH_THRESHOLD=0.90
CACHE_SEARCH_TTL_SECONDS=900
CACHE_RESEARCH_TTL_SECONDS=3600

# RAG Research Token Budgeting
RESEARCH_MAX_CONTEXT_TOKENS=4096
RESEARCH_RESERVED_RESPONSE_TOKENS=1024
RESEARCH_MAX_SOURCES=8
