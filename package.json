{
  "name": "seekr-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Hybrid Search & Research Engine",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @seekr/api dev",
    "dev:worker": "pnpm --filter @seekr/worker dev",
    "dev:web": "pnpm --filter @seekr/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
